#!/bin/bash
# Two jobs: BLOCK on a red gate, REPORT on new sweep hits.
#
# WHY THE SECOND HALF EXISTS. Between this session and the bridge, the same
# mechanism has fired at least six times today: articulate a rule, apply it
# once, then fail to apply it in the very next artifact. The asserted-vs-quoted
# distinction, the eviction effect, the travel rule -- each was described to a
# peer and then violated within the hour by its own author.
#
# That is not a memory problem to be solved by resolving harder. It is the
# default. The only fix either session built today that works without anyone
# remembering anything is this hook, so the text- and shape-cued sweeps run
# here too rather than when someone thinks of them.
#
# They REPORT and do not block: both are known false-positive-heavy by design
# (2 real in 28 here, 1 in 12 on the bridge's repo), so blocking on them would
# train the author to bypass. And the count is reported as a DELTA against the
# last commit -- an unchanging number becomes wallpaper, which is the same
# failure as a check that cannot fire.
cd "$(git rev-parse --show-toplevel)" || exit 1

if ! python3 verify.py > /tmp/vestigium_gate.log 2>&1; then
  echo "COMMIT REFUSED — the gate is red." >&2
  tail -12 /tmp/vestigium_gate.log >&2
  exit 1
fi
echo "gate green ($(grep -c '^ok ' /tmp/vestigium_gate.log) assertions)"

# The LRL gate is 9.3s against verify.py's 0.1s -- too slow to run on every
# commit without training the author to use --no-verify, which is the failure
# this hook exists to prevent. So it runs only when its own files are staged.
if git diff --cached --name-only | grep -q '^qsim/lrl_'; then
  if ! python3 qsim/lrl_gate.py > /tmp/lrl_gate.log 2>&1; then
    echo "COMMIT REFUSED — the LRL gate is red." >&2
    tail -16 /tmp/lrl_gate.log >&2
    exit 1
  fi
  echo "LRL gate green ($(grep -c '^ok ' /tmp/lrl_gate.log) assertions)"
fi

SWEEP=/Users/sumit/Github/.claude-coordination
STATE=.git/sweep_counts
prev=$(cat "$STATE" 2>/dev/null || echo "0 0")
prev_a=${prev% *}; prev_b=${prev#* }

# Sum the REPORTED hit totals, not the printed lines. The sweep truncates its
# display ("... 14 more"), so counting lines measures the display rather than
# the finding -- caught by a control that added a stale claim and saw no delta.
a=$(python3 "$SWEEP/audit_sweep.py" . 2>/dev/null \
    | sed -nE 's/.*— ([0-9]+) hits.*/\1/p' | paste -sd+ - | bc 2>/dev/null || echo 0)
[ -z "$a" ] && a=0
b=$(python3 "$SWEEP/append_only.py" . 2>/dev/null | grep -c "^APPEND-ONLY" || echo 0)
echo "$a $b" > "$STATE"

# SETUP-CORRESPONDENCE, rescued by riding on the commit that adds a prereg.
# bridge's search question -- "what has to happen for this to be used?" -- says
# a pre-registration must be WRITTEN, and writing is followed by committing. So
# the check that a prereg names the condition it runs at can ride here.
#
# The failure it guards: bridge pre-registered three outcomes for the zero-mode
# scaling and measured at FIXED l, when the study runs at fixed l/L. All three
# registered readings were about what the exponent would MEAN; none asked
# whether the setup matched the claim. A prereg that fixes what you will
# conclude still lets you measure the wrong quantity.
for f in $(git diff --cached --name-only --diff-filter=AM | grep -i "prereg" || true); do
  [ -f "$f" ] || continue
  if ! grep -qiE "setup correspondence|condition the (published )?result runs at|runs at the condition|same quantity in the same condition" "$f"; then
    echo "  PREREG WITHOUT A SETUP-CORRESPONDENCE LINE: $f"
    echo "     state which condition this runs at and that it matches the claim."
  fi
done

if [ "$a" -gt "$prev_a" ] 2>/dev/null; then
  echo "  audit_sweep: $a hits (UP from $prev_a) — a claim may have been added, not just moved"
fi
if [ "$b" -gt "$prev_b" ] 2>/dev/null; then
  echo "  append-only sections: $b (UP from $prev_b) — a section grew again without a re-read"
fi
exit 0
